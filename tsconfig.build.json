{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": true,
		"noEmit": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"removeComments": true,
		"outDir": "dist",
		"sourceMap": true,
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts"]
}
